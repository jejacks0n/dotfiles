[core]
	excludesfile = /Users/jejacks0n/.config/git/ignore
	autocrlf = input
	editor = vim
[gpg]
	format = ssh
[user]
	name = Jeremy Jackson
	email = jejacks0n@gmail.com
[gpg "ssh"]
	allowedSignersFile = ~/.config/git/allowedsigners
	defaultKeyCommand = sh -c 'ssh-add -L | awk NF=2 | sed s/^/key::/'
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[commit]
	gpgsign = true
[push]
	default = current
	autoSetupRemote = true
[pull]
	rebase = true
[color]
	ui = auto
	branch = auto
	diff = auto
	interactive = auto
	status = auto
[color "branch"]
	current = yellow reverse
	local = yellow
	remote = green
[color "diff"]
	meta = yellow bold
	frag = magenta bold
	old = red bold
	new = green bold
[color "status"]
	added = green
	changed = brightblue
	untracked = brightred
	unmerged = brightred bold
[alias]
	co = checkout
	br = branch
	ci = commit
	st = status
