{
  "hooks": {
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "name": "notify-needs-input",
            "type": "command",
            "command": "terminal-notifier -title 'Gemini CLI' -message 'Gemini needs your input.' -sound 'Glass' -contentImage '$HOME/.gemini/gemini.png'"
          }
        ]
      }
    ],
    "AfterAgent": [
      {
        "matcher": "*",
        "hooks": [
          {
            "name": "notify-done",
            "type": "command",
            "command": "terminal-notifier -title 'Gemini CLI' -message 'Gemini is finished!' -sound 'Hero' -contentImage '$HOME/.gemini/gemini.png'"
          }
        ]
      }
    ]
  },
  "security": {
    "auth": {
      "selectedType": "gateway"
    }
  },
  "ide": {
    "hasSeenNudge": true
  },
  "general": {
    "preferredEditor": "vim"
  }
}