{
  "hooks": {
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "terminal-notifier -title 'Claude CLI' -message 'Claude needs your input.' -sound 'Hero' -contentImage '$HOME/.claude/claude.png'"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "terminal-notifier -title 'Claude CLI' -message 'Claude is finished!' -sound 'Glass' -contentImage '$HOME/.claude/claude.png'"
          }
        ]
      }
    ]
  }
}