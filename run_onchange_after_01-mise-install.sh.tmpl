#!/bin/bash

# Re-run whenever the global mise config changes.
# mise config hash: {{ include "dot_config/mise/config.toml" | sha256sum }}

# Install the global tools declared in ~/.config/mise/config.toml.
if command -v mise >/dev/null 2>&1; then
  echo "🔧 mise config changed. Installing global tools..."

  mise install -y
else
  echo "❌ mise is not yet installed."
fi
